  "keyFeatures": [
    "Audio transcription via ElevenLabs Scribe with speaker diarization",
    "Local voice recognition using PyTorch and WeSpeaker voice prints",
    "LLM-powered session summaries, ledgers, and recap generation via LiteLLM (OpenAI, Anthropic, Gemini)",
    "Campaign Glossary for consistent names and terminology across sessions",
    "'Previously On' recap and narrative opportunities for next-session preparation",
    "Terminal UI built with Python and Textual",
    "Audio processing and playback via FFmpeg",
    "Local SQLite storage — data stays on your computer"
  ],
  "publicApiSurface": [
    "tablesage (CLI entrypoint — launches TUI)",
    "tablesage-rpg (alias CLI entrypoint)",
    "tablesage report-help-topics",
    "tablesage output-help-topic <topic_id>",
    "tablesage report-schema",
    "tablesage run-query <sql>"
  ]
